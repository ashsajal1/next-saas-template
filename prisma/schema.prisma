// This SaaS template uses Clerk for user management.
// We don't store user data in Prisma - Clerk handles authentication,
// user profiles, and roles. We only store subscription data with
// references to Clerk user IDs.

// Note: This template includes both Prisma and Drizzle. If you choose to use Prisma:
// 1. Delete the /src/db directory
// 2. Delete drizzle.config.ts
// 3. Remove drizzle-related dependencies from package.json
// 4. Run: npm uninstall drizzle-orm @libsql/client drizzle-kit

// Learn more about Prisma: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Subscriptions are linked to Clerk users via clerkUserId
// We don't store user data here - Clerk handles that
model Subscription {
  id                String   @id @default(cuid())
  
  // Link to Clerk user (not stored in our DB)
  clerkUserId       String   @unique
  
  // Stripe customer ID (stored here since we don't have a User model)
  stripeCustomerId  String   @unique
  
  // Stripe subscription details
  stripeSubscriptionId String @unique
  stripePriceId        String
  stripeCurrentPeriodEnd DateTime
  
  // Subscription status
  status            SubscriptionStatus @default(incomplete)
  plan              Plan               @default(starter)
  interval          BillingInterval    @default(month)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Payment history
  invoices          Invoice[]
}

// Track invoice payments for history/receipts
model Invoice {
  id                String   @id @default(cuid())
  subscriptionId    String
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  stripeInvoiceId   String   @unique
  amount            Int      // Amount in cents
  currency          String   @default("usd")
  status            String   // paid, open, void, uncollectible
  
  createdAt         DateTime @default(now())
}

model ContactLead {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  company     String?
  inquiryType String?
  message     String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model DemoLead {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  workEmail         String
  company           String
  teamSize          String
  useCase           String
  timezone          String
  preferredDateTime DateTime?
  recordDemo        Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([createdAt])
}

enum SubscriptionStatus {
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

enum Plan {
  starter
  professional
  business
  enterprise
}

enum BillingInterval {
  month
  year
}
